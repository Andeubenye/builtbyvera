---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="About — builtbyvera">
  <Header />

  <section class="about-simple">
    <div class="about-simple-art">
      <figure class="about-portrait-card">
        <img src="/about/vera-portrait.png" alt="Illustrated portrait of Vera in a workspace" />
        <figcaption>I research, technically?</figcaption>
      </figure>
    </div>

    <div class="about-terminal" aria-label="About Vera terminal">
      <div class="code-bio-chrome">
        <span class="code-bio-dot red"></span>
        <span class="code-bio-dot yellow"></span>
        <span class="code-bio-dot green"></span>
        <span class="code-bio-url">about.md</span>
      </div>

      <div class="about-terminal-body">
        <p><span class="terminal-prompt">$</span> whoami</p>
        <h1>I reverse-engineer technical products into stories and developer assets.</h1>

        <p>
          I started out in SaaS marketing and what we'd now call traditional SEO. I spent
          years chasing rankings, surviving algorithm updates, and learning how technical
          products earn attention.
        </p>

        <p>
          But curiosity kept pulling me closer to the product itself. I wanted to
          understand how things worked, build with them, break them, and explain what I
          found.
        </p>

        <p>
          I earned an Advanced Diploma in Software Engineering, specialising in AI and
          Machine Learning, and started bringing both worlds together.
        </p>

        <p>
          These days, I research technical products from first principles and turn what I
          learn into integrations, starter templates, demos, tutorials, documentation,
          and technical content that help developers understand, trust, and adopt them.
        </p>

        <p class="terminal-output">
          I think like a marketer, build like an engineer, and write like a human.
        </p>
      </div>
    </div>
  </section>

  <Navigation active="about" />
  <Footer />
</BaseLayout>
